# --- Required secrets ---
# OpenSea: instant free key via  curl -X POST https://api.opensea.io/api/v2/auth/keys
# (or a non-expiring key at opensea.io -> Settings -> Developer). Never committed.
OPENSEA_API_KEY=YOUR_OPENSEA_KEY
# Telegram: @BotFather token
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
# Where alerts are POSTED: your private chat id, OR a channel the bot is admin in.
#   public channel -> @channelusername
#   private channel -> its -100... id (run `node bot.js --chat-id` after posting there)
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# --- Optional ---
# Who may RUN commands (/add /remove /list /status /test): comma-separated PRIVATE
# chat ids — each person gets theirs via `node bot.js --chat-id` after messaging the bot.
# Commands only work in private chats, never in the channel. Default: TELEGRAM_CHAT_ID only.
# ADMIN_CHAT_IDS=123456789,987654321
# Alchemy chain URLs live in chains.json (one entry per chain — see chains.example.json)
# First wallet tracked at boot (after that use Telegram /add)
# SEED_WALLET=0x0000000000000000000000000000000000000000
# LOOKBACK_BLOCKS=50          # how far back first-run / gap backfill scans
# MAX_BACKFILL_BLOCKS=500     # per-run cap on backfill blocks (CU guard; cursor advances on later runs)
# CONFIRMATIONS=1             # blocks treated as final when backfilling
# DEDUPE_RETENTION_DAYS=7     # dedupe row lifetime
